  "Pitfall: session per request": {
    "prefix": "sa_pitfall_session",
    "body": [
      "# Sessions are NOT thread-safe. Never share one across requests/threads.",
      "# Pattern: create one session per request (or per unit of work),",
      "# commit, and close.",
      "",
      "with Session(engine) as session:",
      "    # ...",
      "    session.commit()",
      "# session is closed here"
