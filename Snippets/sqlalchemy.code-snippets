    "body": [
      "# BAD: one query for users, one per user for posts",
      "users = session.execute(select(User)).scalars().all()",
      "for u in users:",
      "    print(u.posts)    # N extra queries!",
      "",
      "# GOOD: eager load",
      "stmt = select(User).options(selectinload(User.posts))",
