  },
  "Pitfall: and/or vs &/|": {
    "prefix": "pd_pitfall_bool",
    "body": [
      "# BAD: Python and/or on boolean Series -> ValueError",
      "# df[(df.a > 0) and (df.b < 1)]",
      "",
      "# GOOD: bitwise & | with parentheses",
      "df[(df['${1:a}'] > ${2:0}) & (df['${3:b}'] < ${4:1})]"
    ],
    "description": "Use & | not and/or"
  },
  "Pitfall: inplace is misleading": {
    "prefix": "pd_pitfall_inplace",
    "body": [
      "# 'inplace=True' returns None and does NOT always save memory.",
      "# Prefer reassignment:",
      "df = df.drop(columns=['${1:col}'])",
      "",
      "# The exception: when the operation clearly mutates the same object,",
      "# e.g. df.sort_values(..., inplace=True) -- but even then reassign for clarity."
    ],
    "description": "Avoid inplace"
  },
  "Pitfall: dtype surprises on read": {
    "prefix": "pd_pitfall_dtype",
    "body": [
      "# CSV reads often infer wrong dtypes:",
      "#   - IDs become ints (leading zeros lost)",
      "#   - Dates become strings",
      "#   - 'NA' strings become NaN",
      "# Always specify dtype and parse_dates explicitly.",
      "df = pd.read_csv('${1:data.csv}', dtype={'${2:id}': str}, parse_dates=['${3:date}'])"
    ],
    "description": "Explicit dtypes on read"
  },
  "Pitfall: memory blow-up on merge": {
    "prefix": "pd_pitfall_merge",
    "body": [
      "# ---- Cartesian explosion: N x M rows ----",
      "# If the right side has duplicate keys, merge multiplies rows.",
      "# Check first:",
      "assert right['${1:key}'].is_unique",
      "",
      "# Validate join cardinality explicitly:",
      "pd.merge(left, right, on='${1:key}', validate='many_to_one')"
    ],
    "description": "Merge cardinality checks"
  },
  "Pitfall: silent misalignment": {
    "prefix": "pd_pitfall_align",
    "body": [
      "# Pandas aligns on index when combining Series/DataFrames.",
