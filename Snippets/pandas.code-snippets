{
  "// ==================== 1. IMPORT & SETUP ====================": {
    "prefix": "pd_section_setup",
    "body": ["# ============ IMPORT & SETUP ============"],
    "description": "Section marker"
  },

  "Import Pandas": {
    "prefix": "pd_import",
    "body": [
      "import pandas as pd",
      "import numpy as np",
      "print(pd.__version__)"
    ],
    "description": "Standard Pandas import"
  },
  "Display options": {
    "prefix": "pd_options",
    "body": [
      "# ---- Control display for exploration ----",
      "pd.set_option('display.max_columns', ${1:50})",
      "pd.set_option('display.max_rows', ${2:100})",
      "pd.set_option('display.width', ${3:200})",
      "pd.set_option('display.float_format', '{:.4f}'.format)",
      "# Reset:  pd.reset_option('all')"
    ],
    "description": "Configure Pandas display"
  },

  "// ==================== 2. SERIES BASICS ====================": {
    "prefix": "pd_section_series",
    "body": ["# ============ SERIES BASICS ============"],
    "description": "Section marker"
  },

  "Series create": {
    "prefix": "pd_series",
    "body": [
      "# ---- Series: 1D labelled array ----",
      "s = pd.Series([${1:1, 2, 3, 4}])",
      "s = pd.Series([${1:1, 2, 3}], index=['${2:a}', '${3:b}', '${4:c}'], name='${5:score}')",
      "s = pd.Series({'${2:a}': 1, '${3:b}': 2})   # from dict"
    ],
    "description": "Create a Series"
  },
  "Series access": {
    "prefix": "pd_series_access",
    "body": [
      "# ---- Access by label vs position ----",
      "s['${1:key}']            # by label",
      "s.loc['${1:key}']        # explicit label access",
      "s.iloc[0]                # by position",
      "",
      "# Vectorized ops on the whole series:",
      "s + 1, s * 2, s ** 2, s.mean()"
    ],
    "description": "Series indexing"
  },
  "Series methods": {
    "prefix": "pd_series_methods",
    "body": [
      "s.value_counts()          # frequency of unique values",
      "s.unique()                # unique values (ndarray)",
      "s.nunique()               # number of unique values",
      "s.isna().sum()            # count missing",
      "s.describe()              # summary stats",
      "s.map(${1:func})            # element-wise mapping",
      "s.apply(${1:func})          # element-wise, slower than map",
      "s.replace(${2:old}, ${3:new})",
      "s.clip(${4:0}, ${5:1})"
    ],
    "description": "Common Series methods"
  },

  "// ==================== 3. DATAFRAME CREATION ====================": {
    "prefix": "pd_section_create",
    "body": ["# ============ DATAFRAME CREATION ============"],
    "description": "Section marker"
  },

  "DataFrame from dict": {
    "prefix": "pd_df_dict",
    "body": [
      "# ---- Column-oriented dict: most common ----",
      "df = pd.DataFrame({",
      "    '${1:name}': ['${2:Alice}', '${3:Bob}', '${4:Carol}'],",
      "    '${5:age}':  [${6:30}, ${7:25}, ${8:35}],",
      "    '${9:city}': ['${10:Paris}', '${11:London}', '${12:Berlin}'],",
      "})"
    ],
    "description": "DataFrame from dict of lists"
  },
  "DataFrame from records": {
    "prefix": "pd_df_records",
    "body": [
      "# ---- Row-oriented: list of dicts ----",
      "df = pd.DataFrame([",
      "    {'${1:name}': '${2:Alice}', '${3:age}': ${4:30}},",
      "    {'${1:name}': '${5:Bob}',   '${3:age}': ${6:25}},",
      "])"
    ],
    "description": "DataFrame from list of dicts"
  },
  "DataFrame from arrays": {
    "prefix": "pd_df_arrays",
    "body": [
      "df = pd.DataFrame(${1:arr}, columns=[${2:'a', 'b', 'c'}])",
      "df = pd.DataFrame(${1:arr}, columns=${3:cols}, index=${4:idx})"
    ],
    "description": "DataFrame from NumPy array"
  },
  "Empty DataFrame with schema": {
    "prefix": "pd_df_empty",
    "body": [
      "df = pd.DataFrame(columns=[${1:'a', 'b', 'c'}], dtype=${2:float})"
    ],
    "description": "Empty DataFrame with defined schema"
  },
  "Set index": {
    "prefix": "pd_set_index",
    "body": [
      "# ---- Use an existing column as the index ----",
      "df = df.set_index('${1:id}')",
      "# Restore:",
      "df = df.reset_index()",
      "# Keep the old index as a column:",
      "df = df.reset_index(drop=False)"
    ],
    "description": "Set / reset index"
  },

  "// ==================== 4. INSPECTION ====================": {
    "prefix": "pd_section_inspect",
    "body": ["# ============ INSPECTION ============"],
    "description": "Section marker"
  },

  "First look": {
    "prefix": "pd_inspect",
    "body": [
      "df.head(${1:5})          # first rows",
      "df.tail(${1:5})          # last rows",
      "df.sample(${2:5})        # random rows",
      "df.shape                # (rows, cols)",
      "df.columns.tolist()     # column names",
      "df.dtypes               # per-column dtype",
      "df.info()               # dtypes + nulls + memory",
      "df.describe()           # numeric summary",
      "df.describe(include='all')  # include categorical"
    ],
    "description": "Inspect a DataFrame"
  },
  "Summary of missing values": {
    "prefix": "pd_inspect_nulls",
    "body": [
      "df.isna().sum()                     # count per column",
      "df.isna().mean().sort_values(ascending=False)   # fraction",
      "# Columns with any NaN:",
      "cols_with_na = df.columns[df.isna().any()].tolist()"
    ],
    "description": "Summarize missing values"
  },
  "Value counts & unique": {
    "prefix": "pd_inspect_counts",
    "body": [
      "df['${1:col}'].value_counts(dropna=False)",
      "df['${1:col}'].nunique()",
      "df['${1:col}'].unique()"
    ],
    "description": "Frequency and uniqueness"
  },

  "// ==================== 5. SELECTION (loc, iloc, at, iat) ====================": {
    "prefix": "pd_section_select",
    "body": ["# ============ SELECTION ============"],
    "description": "Section marker"
  },

  "Column selection": {
    "prefix": "pd_columns",
    "body": [
      "df['${1:col}']                        # Series",
      "df[['${1:col}', '${2:col2}']]           # DataFrame (note double brackets)",
      "df.filter(like='${3:prefix}')           # columns containing substring",
      "df.filter(regex='^${4:col_}')            # regex match on column names"
    ],
    "description": "Select columns"
  },
  "loc (label-based)": {
    "prefix": "pd_loc",
    "body": [
      "# ---- .loc: label-based indexing (INCLUSIVE of the endpoint) ----",
      "df.loc[${1:row_label}]",
      "df.loc[${2:row_label}, '${3:col}']",
      "df.loc[${4:start}:${5:end}]                    # rows by label range",
      "df.loc[:, '${3:col}':]                 # columns from a label onwards",
      "df.loc[${6:cond}, ['${3:col}', '${7:col2}']]  # mask + columns"
    ],
    "description": "Label-based indexing with .loc"
  },
  "iloc (position-based)": {
    "prefix": "pd_iloc",
    "body": [
      "# ---- .iloc: integer-position indexing (EXCLUSIVE of the endpoint) ----",
      "df.iloc[0]                    # first row",
      "df.iloc[-1]                   # last row",
      "df.iloc[0:5]                  # first 5 rows",
      "df.iloc[:, 0:3]               # first 3 columns",
      "df.iloc[0:5, 0:3]             # submatrix"
    ],
    "description": "Position-based indexing with .iloc"
  },
  "at / iat (scalar access)": {
    "prefix": "pd_at_iat",
    "body": [
      "df.at[${1:row_label}, '${2:col}']       # scalar by label (fast)",
      "df.iat[${3:0}, ${4:0}]                   # scalar by position (fast)"
    ],
    "description": "Fast scalar access"
  },

  "// ==================== 6. FILTERING ====================": {
    "prefix": "pd_section_filter",
    "body": ["# ============ FILTERING ============"],
    "description": "Section marker"
  },

  "Boolean mask": {
    "prefix": "pd_filter_mask",
    "body": [
      "# ---- Filter rows by condition ----",
      "df[df['${1:col}'] > ${2:0}]",
      "",
      "# Combine with & | ~ (parenthesise each condition!)",
      "df[(df['${1:col}'] > ${2:0}) & (df['${3:col2}'] < ${4:100})]",
      "df[(df['${1:col}'] == '${5:x}') | (df['${3:col2}'].isna())]",
      "",
      "# Membership",
      "df[df['${1:col}'].isin([${6:v1}, ${7:v2}])]",
      "df[~df['${1:col}'].isin([${6:v1}, ${7:v2}])]"
    ],
    "description": "Boolean-mask filtering"
  },
  "query (readable filtering)": {
    "prefix": "pd_query",
    "body": [
      "# ---- .query(): SQL-like filter with @ for local variables ----",
      "df.query('${1:age} > ${2:30} and ${3:city} == \"${4:Paris}\"')",
      "df.query('${1:age} > @${5:min_age}')   # uses outer variable",
      "df.query('${1:name}.str.startswith(\"${6:A}\")')"
    ],
    "description": "Readable filtering with query()"
  },
  "Filter by NaN": {
    "prefix": "pd_filter_na",
    "body": [
      "df[df['${1:col}'].isna()]",
      "df[df['${1:col}'].notna()]",
      "df.dropna(subset=['${1:col}'])"
    ],
    "description": "Filter rows with / without NaN"
  },
  "nlargest / nsmallest": {
    "prefix": "pd_nlargest",
    "body": [
      "df.nlargest(${1:5}, '${2:score}')",
      "df.nsmallest(${1:5}, '${2:score}')"
    ],
    "description": "Top/bottom N rows by a column"
  },

  "// ==================== 7. ADDING & MODIFYING COLUMNS ====================": {
    "prefix": "pd_section_addcol",
    "body": ["# ============ ADDING & MODIFYING COLUMNS ============"],
    "description": "Section marker"
  },

  "Assign new column": {
    "prefix": "pd_assign",
    "body": [
      "# ---- Direct assignment ----",
      "df['${1:new_col}'] = ${2:value}",
      "",
      "# ---- Vectorized expression ----",
      "df['${1:new_col}'] = df['${3:a}'] + df['${4:b}']",
      "",
      "# ---- Multiple columns at once with .assign ----",
      "df = df.assign(",
      "    ${1:new_col}=lambda d: d['${3:a}'] * 2,",
      "    ${5:other}=lambda d: d['${4:b}'].str.lower(),",
      ")"
    ],
    "description": "Add new columns"
  },
  "Conditional column (np.where / select)": {
    "prefix": "pd_assign_cond",
    "body": [
      "# ---- if/else vectorized ----",
      "df['${1:label}'] = np.where(df['${2:score}'] >= ${3:0.5}, '${4:positive}', '${5:negative}')",
      "",
      "# ---- Multiple branches ----",
      "df['${1:label}'] = np.select(",
      "    [df['${2:score}'] >= ${6:0.8}, df['${2:score}'] >= ${3:0.5}],",
      "    ['${7:high}', '${4:positive}'],",
      "    default='${5:negative}',",
      ")"
    ],
    "description": "Conditional columns"
  },
  "Apply / map / applymap": {
    "prefix": "pd_apply",
    "body": [
      "# ---- Row/column-wise apply ----",
      "df['${1:new}'] = df.apply(lambda row: ${2:func(row['${3:a}'])}, axis=1)   # row-wise",
      "df.apply(${2:func})                                     # column-wise (default)",
      "",
      "# ---- Element-wise for a single column ----",
      "df['${1:new}'] = df['${3:a}'].map(${2:func})",
      "",
      "# ---- Element-wise for the entire DataFrame ----",
      "df.map(${2:func})       # pandas >= 2.1 (was applymap)"
    ],
    "description": "apply / map / map DataFrame"
  },
  "Rename columns": {
    "prefix": "pd_rename",
    "body": [
      "# ---- Rename specific columns ----",
      "df = df.rename(columns={'${1:old}': '${2:new}'})",
      "",
      "# ---- Bulk transform names ----",
      "df.columns = df.columns.str.lower().str.replace(' ', '_')",
      "df.columns = [c.strip() for c in df.columns]"
    ],
    "description": "Rename columns"
  },
  "Reindex / reorder columns": {
    "prefix": "pd_reorder",
    "body": [
      "df = df[[${1:'col2', 'col1', 'col3'}]]                  # explicit order",
      "df = df.reindex(columns=[${1:'col2', 'col1', 'col3'}])  # NaN if missing"
    ],
    "description": "Reorder columns"
  },

  "// ==================== 8. DROPPING ====================": {
    "prefix": "pd_section_drop",
    "body": ["# ============ DROPPING ============"],
    "description": "Section marker"
  },

  "Drop columns / rows": {
    "prefix": "pd_drop",
    "body": [
      "df.drop(columns=['${1:col}'])                        # single",
      "df.drop(columns=['${1:col}', '${2:col2}'])             # multiple",
      "df.drop(index=[${3:0, 1, 2}])                          # rows by label",
      "",
      "# In place (avoid; prefer reassignment):",
      "df.drop(columns=['${1:col}'], inplace=True)"
    ],
    "description": "Drop columns or rows"
  },
  "Drop duplicates": {
    "prefix": "pd_drop_duplicates",
    "body": [
      "df.drop_duplicates()                                   # full-row dupes",
      "df.drop_duplicates(subset=['${1:id}'])                 # by column(s)",
      "df.drop_duplicates(subset=['${1:id}'], keep='last')     # keep last",
      "df.drop_duplicates(subset=['${1:id}'], keep=False)      # drop all dupes"
    ],
    "description": "Drop duplicate rows"
  },

  "// ==================== 9. MISSING DATA ====================": {
    "prefix": "pd_section_missing",
    "body": ["# ============ MISSING DATA ============"],
    "description": "Section marker"
  },

  "Detect missing": {
    "prefix": "pd_isna",
    "body": [
      "df.isna()                     # element-wise",
      "df.isna().sum()               # per column",
      "df.isna().any(axis=1)         # per row",
      "df.notna().all()              # True per column with no missing"
    ],
    "description": "Detect missing values"
  },
  "Drop missing": {
    "prefix": "pd_dropna",
    "body": [
      "df.dropna()                           # any NaN in the row",
      "df.dropna(how='all')                  # all-NaN rows",
      "df.dropna(subset=['${1:col}'])        # only these columns matter",
      "df.dropna(thresh=${2:3})               # keep rows with >= 3 non-NaN"
    ],
    "description": "Drop rows/cols with NaN"
  },
  "Fill missing": {
    "prefix": "pd_fillna",
    "body": [
      "# ---- Constant ----",
      "df['${1:col}'].fillna(${2:0})",
      "",
      "# ---- Per-column strategy ----",
      "df.fillna({'${1:col}': ${2:0}, '${3:col2}': '${4:missing}'})",
      "",
      "# ---- Statistical imputation ----",
      "df['${1:col}'].fillna(df['${1:col}'].mean())",
      "df['${1:col}'].fillna(df['${1:col}'].median())",
      "df['${1:col}'].fillna(df['${1:col}'].mode()[0])",
      "",
      "# ---- Forward / backward fill (time series!) ----",
      "df['${1:col}'].ffill()",
      "df['${1:col}'].bfill()"
    ],
    "description": "Fill missing values"
  },
  "Interpolate": {
    "prefix": "pd_interpolate",
    "body": [
      "# ---- Linear interpolation (time series) ----",
      "df['${1:col}'].interpolate(method='linear')",
      "df['${1:col}'].interpolate(method='time')   # requires DatetimeIndex"
    ],
    "description": "Interpolate missing values"
  },

  "// ==================== 10. SORTING & RANKING ====================": {
    "prefix": "pd_section_sort",
    "body": ["# ============ SORTING & RANKING ============"],
    "description": "Section marker"
  },

  "Sort": {
    "prefix": "pd_sort",
    "body": [
      "df.sort_values('${1:col}')",
      "df.sort_values('${1:col}', ascending=False)",
      "df.sort_values(['${1:col}', '${2:col2}'], ascending=[True, False])",
      "df.sort_index()"
    ],
    "description": "Sort values or index"
  },
  "Rank": {
    "prefix": "pd_rank",
    "body": [
      "df['${1:rank}'] = df['${2:score}'].rank(method='${3:average}', ascending=False)",
      "# methods: average, min, max, first, dense"
    ],
    "description": "Rank values"
  },

  "// ==================== 11. GROUPBY (AGGREGATE / TRANSFORM / FILTER / APPLY) ====================": {
    "prefix": "pd_section_groupby",
    "body": ["# ============ GROUPBY ============"],
    "description": "Section marker"
  },

  "GroupBy aggregate": {
    "prefix": "pd_groupby",
    "body": [
      "# ---- Split-apply-combine ----",
      "df.groupby('${1:key}')['${2:value}'].mean()",
      "df.groupby('${1:key}')[['${2:value}', '${3:value2}']].agg(['mean', 'std', 'count'])",
      "",
      "# Named aggregations (clean output)",
      "df.groupby('${1:key}').agg(",
      "    ${4:total}=('${2:value}', 'sum'),",
      "    ${5:avg}=('${2:value}', 'mean'),",
      "    ${6:n}=('${3:value2}', 'size'),",
      ")"
    ],
    "description": "GroupBy + aggregations"
  },
  "GroupBy multi-key": {
    "prefix": "pd_groupby_multi",
    "body": [
      "df.groupby(['${1:key1}', '${2:key2}'])['${3:value}'].mean().unstack()"
    ],
    "description": "Group by multiple keys"
  },
  "GroupBy transform": {
    "prefix": "pd_groupby_transform",
    "body": [
      "# ---- Return an array aligned with the original DataFrame ----",
      "df['${1:group_mean}'] = df.groupby('${2:key}')['${3:value}'].transform('mean')",
      "",
      "# Feature engineering: mean-encode a category",
      "df['${1:group_mean}'] = df.groupby('${2:key}')['${3:value}'].transform('mean')",
      "",
      "# Normalize within groups",
      "df['${4:z}'] = df.groupby('${2:key}')['${3:value}'].transform(",
      "    lambda s: (s - s.mean()) / (s.std() + 1e-8)",
      ")"
    ],
    "description": "GroupBy transform (keeps shape)"
  },
  "GroupBy filter": {
    "prefix": "pd_groupby_filter",
    "body": [
      "# ---- Keep groups that satisfy a condition ----",
      "df.groupby('${1:key}').filter(lambda g: len(g) >= ${2:10})",
      "df.groupby('${1:key}').filter(lambda g: g['${3:value}'].mean() > ${4:100})"
    ],
    "description": "Filter groups"
  },
  "GroupBy apply": {
    "prefix": "pd_groupby_apply",
    "body": [
      "# ---- apply: arbitrary function per group ----",
      "df.groupby('${1:key}').apply(lambda g: ${2:func(g)})",
      "",
      "# Access the group key inside:",
      "df.groupby('${1:key}').apply(lambda g: pd.Series({",
      "    'n': len(g),",
      "    'mean': g['${3:value}'].mean(),",
      "}))"
    ],
    "description": "GroupBy apply"
  },
  "GroupBy nlargest": {
    "prefix": "pd_groupby_nlargest",
    "body": [
      "# ---- Top-N per group ----",
      "df.groupby('${1:key}').apply(lambda g: g.nlargest(${2:3}, '${3:score}'))",
      "# Or (preferred):",
      "df.sort_values('${3:score}', ascending=False).groupby('${1:key}').head(${2:3})"
    ],
    "description": "Top-N rows per group"
  },
  "Crosstab / pivot table": {
    "prefix": "pd_crosstab",
    "body": [
      "# ---- Frequency cross-tab ----",
      "pd.crosstab(df['${1:row}'], df['${2:col}'])",
      "pd.crosstab(df['${1:row}'], df['${2:col}'], normalize='index')   # row %",
      "",
      "# ---- Pivot table with aggregation ----",
      "df.pivot_table(",
      "    index='${1:row}',",
      "    columns='${2:col}',",
      "    values='${3:value}',",
      "    aggfunc='${4:mean}',",
      ")"
    ],
    "description": "Crosstab and pivot table"
  },

  "// ==================== 12. MERGING & JOINING ====================": {
    "prefix": "pd_section_merge",
    "body": ["# ============ MERGING & JOINING ============"],
    "description": "Section marker"
  },

  "Merge (SQL-style join)": {
    "prefix": "pd_merge",
    "body": [
      "# ---- SQL-style joins ----",
      "pd.merge(left, right, on='${1:key}', how='inner')   # inner/left/right/outer",
      "pd.merge(left, right, left_on='${2:a}', right_on='${3:b}', how='left')",
      "",
      "# Suffixes when both sides share column names:",
      "pd.merge(left, right, on='${1:key}', suffixes=('_x', '_y'))",
      "",
      "# Validate join (catch duplicate keys):",
      "pd.merge(left, right, on='${1:key}', validate='one_to_one')"
    ],
    "description": "Merge DataFrames"
  },
  "Concatenate (stack)": {
    "prefix": "pd_concat",
    "body": [
      "# ---- Stack rows (same columns) ----",
      "pd.concat([df1, df2], axis=0, ignore_index=True)",
      "",
      "# ---- Stack columns (same index) ----",
      "pd.concat([df1, df2], axis=1)",
      "",
      "# ---- Keep track of source ----",
      "pd.concat([df1, df2], keys=['${1:train}', '${2:test}'])"
    ],
    "description": "Concatenate DataFrames"
  },
  "Join on index": {
    "prefix": "pd_join",
    "body": [
      "df1.join(df2, how='left')                  # index-based",
      "df1.join(df2.set_index('${1:key}'))         # join on a column"
    ],
    "description": "Join on index"
  },

  "// ==================== 13. RESHAPING (PIVOT / MELT / STACK) ====================": {
    "prefix": "pd_section_reshape",
    "body": ["# ============ RESHAPING ============"],
    "description": "Section marker"
  },

  "Pivot (long -> wide)": {
    "prefix": "pd_pivot",
    "body": [
      "# ---- Reshape long to wide ----",
      "df.pivot(index='${1:date}', columns='${2:symbol}', values='${3:price}')",
      "",
      "# With aggregation (duplicates):",
      "df.pivot_table(index='${1:date}', columns='${2:symbol}', values='${3:price}', aggfunc='mean')"
    ],
    "description": "Pivot long to wide"
  },
  "Melt (wide -> long)": {
    "prefix": "pd_melt",
    "body": [
      "# ---- Reshape wide to long (tidy data) ----",
      "df.melt(",
      "    id_vars=['${1:id}'],",
      "    value_vars=['${2:col1}', '${3:col2}'],",
      "    var_name='${4:variable}',",
      "    value_name='${5:value}',",
      ")"
    ],
    "description": "Melt wide to long"
  },
  "Stack / unstack": {
    "prefix": "pd_stack",
    "body": [
