      "# ---- Permutation test (no distributional assumption) ----",
      "def permutation_test(a, b, n=10000, rng=None):",
      "    rng = rng or np.random.default_rng(42)",
      "    observed = np.mean(a) - np.mean(b)",
      "    combined = np.concatenate([a, b])",
      "    count = 0",
      "    for _ in range(n):",
      "        rng.shuffle(combined)",
      "        diff = np.mean(combined[:len(a)]) - np.mean(combined[len(a):])",
      "        if abs(diff) >= abs(observed):",
      "            count += 1",
      "    return count / n   # p-value"
    ],
    "description": "Permutation test"
