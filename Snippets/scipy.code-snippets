  "Logistic regression (custom)": {
    "prefix": "sc_ml_logreg",
    "body": [
      "from scipy.optimize import minimize",
      "",
      "def sigmoid(z):",
      "    return 1 / (1 + np.exp(-z))",
      "",
      "def neg_log_likelihood(w, X, y):",
      "    p = sigmoid(X @ w)",
      "    return -np.sum(y * np.log(p + 1e-12) + (1 - y) * np.log(1 - p + 1e-12))",
      "",
      "Xb = np.hstack([np.ones((X.shape[0], 1)), X])",
      "result = minimize(neg_log_likelihood, x0=np.zeros(Xb.shape[1]), args=(Xb, y))",
      "w = result.x",
      "",
      "probabilities = sigmoid(Xb @ w)",
      "predictions = (probabilities > 0.5).astype(int)"
