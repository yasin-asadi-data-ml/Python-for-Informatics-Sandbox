{
  "// ==================== 1. DOCUMENT STRUCTURE ====================": {
    "prefix": "md_section_structure",
    "body": ["<!-- ============ DOCUMENT STRUCTURE ============ -->"],
    "description": "Section marker (HTML comment)"
  },

  "Heading 1": {
    "prefix": "md_h1",
    "body": ["# ${1:Title}"],
    "description": "Top-level heading"
  },
  "Heading 2": {
    "prefix": "md_h2",
    "body": ["## ${1:Section}"],
    "description": "Second-level heading"
  },
  "Heading 3": {
    "prefix": "md_h3",
    "body": ["### ${1:Subsection}"],
    "description": "Third-level heading"
  },
  "Heading (any level)": {
    "prefix": "md_heading",
    "body": ["${1|#, ##, ###, ####, #####, ######|} ${2:Title}"],
    "description": "Heading with level chooser"
  },
  "Anchor link to a heading": {
    "prefix": "md_anchor",
    "body": ["[${1:Link text}](#${2:section-anchor})"],
    "description": "Jump link to a heading (GitHub slug)"
  },
  "Table of contents": {
    "prefix": "md_toc",
    "body": [
      "## Table of Contents",
      "",
      "- [${1:Section 1}](#${2:section-1})",
      "- [${3:Section 2}](#${4:section-2})",
      "- [${5:Section 3}](#${6:section-3})"
    ],
    "description": "Manual table of contents"
  },
  "Horizontal rule": {
    "prefix": "md_hr",
    "body": ["---"],
    "description": "Horizontal rule / section divider"
  },

  "// ==================== 2. TEXT FORMATTING ====================": {
    "prefix": "md_section_format",
    "body": ["<!-- ============ TEXT FORMATTING ============ -->"],
    "description": "Section marker"
  },

  "Bold": {
    "prefix": "md_bold",
    "body": ["**${1:bold text}**"],
    "description": "Bold text"
  },
  "Italic": {
    "prefix": "md_italic",
    "body": ["*${1:italic text}*"],
    "description": "Italic text"
  },
  "Bold + italic": {
    "prefix": "md_bolditalic",
    "body": ["***${1:bold italic}***"],
    "description": "Bold and italic"
  },
  "Strikethrough": {
    "prefix": "md_strike",
    "body": ["~~${1:struck text}~~"],
    "description": "Strikethrough"
  },
  "Inline code": {
    "prefix": "md_code_inline",
    "body": ["`${1:code}`"],
    "description": "Inline code span"
  },
  "Highlight (HTML)": {
    "prefix": "md_mark",
    "body": ["<mark>${1:highlighted}</mark>"],
    "description": "Highlight text (renders on most platforms)"
  },
  "Subscript / superscript": {
    "prefix": "md_subsup",
    "body": [
      "H<sub>${1:2}</sub>O",
      "E = mc<sup>${2:2}</sup>"
    ],
    "description": "Subscript and superscript (HTML)"
  },
  "Keyboard shortcut": {
    "prefix": "md_kbd",
    "body": ["<kbd>${1:Ctrl}</kbd> + <kbd>${2:S}</kbd>"],
    "description": "Keyboard shortcut styling"
  },
  "Escape special characters": {
    "prefix": "md_escape",
    "body": ["\\\\${1:*}"],
    "description": "Escape a Markdown special char"
  },

  "// ==================== 3. LISTS ====================": {
    "prefix": "md_section_lists",
    "body": ["<!-- ============ LISTS ============ -->"],
    "description": "Section marker"
  },

  "Bullet list": {
    "prefix": "md_ul",
    "body": [
      "- ${1:first item}",
      "- ${2:second item}",
      "- ${3:third item}"
    ],
    "description": "Unordered list"
  },
  "Numbered list": {
    "prefix": "md_ol",
    "body": [
      "1. ${1:first}",
      "2. ${2:second}",
      "3. ${3:third}"
    ],
    "description": "Ordered list"
  },
  "Nested list": {
    "prefix": "md_ul_nested",
    "body": [
      "- ${1:parent item}",
      "  - ${2:child item}",
      "    - ${3:grandchild item}",
      "- ${4:another parent}"
