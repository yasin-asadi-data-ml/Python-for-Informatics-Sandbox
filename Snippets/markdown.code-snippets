  },
  "Image": {
    "prefix": "md_img",
    "body": ["![${1:alt text}](${2:path/to/image.png})"],
    "description": "Image"
  },
  "Image with title": {
    "prefix": "md_img_title",
    "body": ["![${1:alt text}](${2:path/to/image.png} \"${3:Title}\")"],
