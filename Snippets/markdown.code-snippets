  "// ==================== 8. MATH (LaTeX) ====================": {
    "prefix": "md_section_math",
    "body": ["<!-- ============ MATH (LaTeX) ============ -->"],
    "description": "Section marker"
  },

  "Inline math": {
    "prefix": "md_math_inline",
    "body": ["\\$${1:x^2 + y^2}\\$"],
    "description": "Inline math expression"
  },
  "Display math (block)": {
    "prefix": "md_math_block",
    "body": [
      "\\$\\$",
      "${1:\\\\hat{y} = \\\\sigma(W x + b)}",
      "\\$\\$"
    ],
    "description": "Display math block"
  },
  "Aligned equations": {
    "prefix": "md_math_align",
    "body": [
      "\\$\\$",
      "\\\\begin{aligned}",
      "${1:L(\\\\theta)} &= ${2:-\\\\frac{1}{N} \\\\sum_{i=1}^{N} y_i \\\\log \\\\hat{y}_i} \\\\\\\\",
      "${3:\\\\nabla_\\\\theta L} &= ${4:\\\\frac{\\\\partial L}{\\\\partial \\\\theta}}",
      "\\\\end{aligned}",
      "\\$\\$"
    ],
    "description": "Multi-line aligned equations"
  },
  "Matrix": {
    "prefix": "md_math_matrix",
    "body": [
      "\\$\\$",
      "${1:X} = \\\\begin{bmatrix}",
      "${2:1} & ${3:0} & ${4:0} \\\\\\\\",
      "${5:0} & ${6:1} & ${7:0} \\\\\\\\",
      "${8:0} & ${9:0} & ${10:1}",
      "\\\\end{bmatrix}",
      "\\$\\$"
    ],
    "description": "Matrix notation"
  },
  "Summation": {
    "prefix": "md_math_sum",
    "body": ["\\$\\$\\\\sum_{${1:i=1}}^{${2:N}} ${3:x_i}\\$\\$"],
    "description": "Summation"
  },
  "Gradient / derivative": {
    "prefix": "md_math_grad",
    "body": ["\\$\\\\nabla_{${1:\\\\theta}} ${2:L(\\\\theta)}\\$"],
    "description": "Gradient notation"
  },
  "Common ML equations": {
    "prefix": "md_math_ml",
    "body": [
      "<!-- Linear regression -->",
      "\\$\\\\hat{y} = X w + b\\$",
      "",
      "<!-- Logistic (sigmoid) -->",
      "\\$\\\\sigma(z) = \\\\frac{1}{1 + e^{-z}}\\$",
      "",
      "<!-- MSE loss -->",
      "\\$L = \\\\frac{1}{N} \\\\sum_{i=1}^{N} (y_i - \\\\hat{y}_i)^2\\$",
      "",
      "<!-- Cross-entropy -->",
      "\\$L = -\\\\frac{1}{N} \\\\sum_{i=1}^{N} y_i \\\\log \\\\hat{y}_i\\$"
    ],
    "description": "Common ML formulas"
  },

