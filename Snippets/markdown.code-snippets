    "description": "GitHub-style task list"
  },
  "Definition list (HTML)": {
    "prefix": "md_deflist",
    "body": [
      "<dl>",
      "  <dt>${1:Term}</dt>",
      "  <dd>${2:Definition}</dd>",
      "  <dt>${3:Another term}</dt>",
      "  <dd>${4:Its definition}</dd>",
