      "q1, _, q3 = statistics.quantiles(data, n=4)",
      "iqr = q3 - q1",
      "",
      "lower = q1 - 1.5 * iqr",
      "upper = q3 + 1.5 * iqr",
      "",
      "outliers = [x for x in data if x < lower or x > upper]",
