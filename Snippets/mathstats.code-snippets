  "Math: isclose (safe float comparison)": {
    "prefix": "py_math_isclose",
    "body": [
      "# math.isclose(a, b, *, rel_tol=1e-09, abs_tol=0.0) -> bool",
      "# Data analysis: NEVER use == for floats!  Use isclose instead.",
      "math.isclose(0.1 + 0.2, 0.3)                # True",
