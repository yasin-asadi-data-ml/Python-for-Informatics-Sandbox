  "Basic train/test split": {
    "prefix": "sk_split",
    "body": [
      "# ---- Train/test split ----",
      "X_train, X_test, y_train, y_test = train_test_split(",
      "    X, y,",
      "    test_size=${1:0.2},",
      "    random_state=${2:42},",
