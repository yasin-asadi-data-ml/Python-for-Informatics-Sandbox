    "description": "Split into train/test"
  },
  "Train/val/test split": {
    "prefix": "sk_split_three",
    "body": [
      "# ---- Train / validation / test ----",
      "# First split off test",
      "X_temp, X_test, y_temp, y_test = train_test_split(",
      "    X, y, test_size=${1:0.2}, random_state=42, stratify=y,",
      ")",
      "# Then split the rest into train/val",
      "X_train, X_val, y_train, y_val = train_test_split(",
      "    X_temp, y_temp, test_size=${2:0.25}, random_state=42, stratify=y_temp,",
      ")",
      "# => train 60%, val 20%, test 20%"
    ],
    "description": "Train/val/test split"
  },
  "Time-series split": {
    "prefix": "sk_split_time",
    "body": [
      "# ---- Time-series split (NO shuffling!) ----",
      "from sklearn.model_selection import TimeSeriesSplit",
      "",
      "tscv = TimeSeriesSplit(n_splits=${1:5})",
      "for train_idx, test_idx in tscv.split(X):",
      "    X_train, X_test = X[train_idx], X[test_idx]",
      "    y_train, y_test = y[train_idx], y[test_idx]"
    ],
    "description": "Time-series-aware split"
  },
