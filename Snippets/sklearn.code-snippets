      "from sklearn.pipeline import Pipeline",
      "from sklearn.preprocessing import StandardScaler",
      "from sklearn.linear_model import LogisticRegression",
      "",
      "pipe = Pipeline([",
      "    ('scaler', StandardScaler()),",
      "    ('clf', LogisticRegression(random_state=42)),",
      "])",
      "",
      "pipe.fit(X_train, y_train)",
      "y_pred = pipe.predict(X_test)"
    ],
    "description": "Simple pipeline"
  },
  "make_pipeline": {
    "prefix": "sk_make_pipeline",
    "body": [
      "# ---- make_pipeline: no names needed ----",
      "from sklearn.pipeline import make_pipeline",
      "",
      "pipe = make_pipeline(",
      "    StandardScaler(),",
      "    ${1:LogisticRegression(random_state=42)},",
      ")"
    ],
    "description": "make_pipeline shortcut"
  },
  "ColumnTransformer (mixed types)": {
    "prefix": "sk_column_transformer",
    "body": [
      "# ---- ColumnTransformer: different preprocessing per column group ----",
      "from sklearn.compose import ColumnTransformer",
      "from sklearn.preprocessing import StandardScaler, OneHotEncoder",
      "from sklearn.impute import SimpleImputer",
      "",
      "numeric_cols = [${1:'age', 'income'}]",
      "categorical_cols = [${2:'city', 'gender'}]",
      "",
      "preprocessor = ColumnTransformer([",
      "    ('num', Pipeline([",
      "        ('imputer', SimpleImputer(strategy='median')),",
      "        ('scaler',  StandardScaler()),",
      "    ]), numeric_cols),",
      "    ('cat', Pipeline([",
      "        ('imputer', SimpleImputer(strategy='most_frequent')),",
      "        ('ohe',     OneHotEncoder(handle_unknown='ignore')),",
      "    ]), categorical_cols),",
      "])"
    ],
    "description": "ColumnTransformer for mixed types"
  },
  "Full pipeline (mixed types + model)": {
    "prefix": "sk_pipeline_full",
    "body": [
      "# ---- End-to-end pipeline: preprocessing + model ----",
      "from sklearn.pipeline import Pipeline",
      "from sklearn.compose import ColumnTransformer",
      "from sklearn.preprocessing import StandardScaler, OneHotEncoder",
      "from sklearn.impute import SimpleImputer",
      "",
      "numeric_pipe = Pipeline([",
      "    ('imputer', SimpleImputer(strategy='median')),",
      "    ('scaler',  StandardScaler()),",
      "])",
      "categorical_pipe = Pipeline([",
      "    ('imputer', SimpleImputer(strategy='most_frequent')),",
      "    ('ohe',     OneHotEncoder(handle_unknown='ignore')),",
      "])",
      "preprocessor = ColumnTransformer([",
      "    ('num', numeric_pipe, ${1:numeric_cols}),",
      "    ('cat', categorical_pipe, ${2:categorical_cols}),",
      "])",
      "",
      "full_pipe = Pipeline([",
      "    ('prep', preprocessor),",
      "    ('clf',  ${3:LogisticRegression(random_state=42)}),",
      "])",
      "",
      "full_pipe.fit(X_train, y_train)",
      "y_pred = full_pipe.predict(X_test)"
    ],
    "description": "Full pipeline with preprocessing + model"
  },
