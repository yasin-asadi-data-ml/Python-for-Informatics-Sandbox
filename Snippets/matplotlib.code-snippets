  "Pitfall: pyplot vs OO mixing": {
    "prefix": "plt_pitfall_mixing",
    "body": [
      "# BAD: mixing pyplot state-machine and OO confusingly",
      "# plt.plot(x, y)",
      "# ax = plt.gca()",
      "# ax.set_title('...')",
      "",
      "# GOOD: pick one style per figure",
      "fig, ax = plt.subplots()",
