  },
  "Pitfall: labels lost on multiple plots": {
    "prefix": "plt_pitfall_labels",
    "body": [
      "# BAD: only one legend() call collects the labels",
      "# ax.plot(x, y1); ax.legend()   # only y1",
      "# ax.plot(x, y2)",
      "",
      "# GOOD: label everything, then call legend once",
      "ax.plot(x, y1, label='y1')",
      "ax.plot(x, y2, label='y2')",
      "ax.legend()"
    ],
    "description": "Collect all labels before legend()"
  },
  "Pitfall: overlapping subplot labels": {
    "prefix": "plt_pitfall_overlap",
    "body": [
      "# BAD: titles/labels overlap between subplots",
      "# GOOD: use tight/constrained layout",
      "fig, axes = plt.subplots(2, 2, constrained_layout=True)",
      "# ...",
      "# or: fig.tight_layout()"
    ],
    "description": "Fix subplot overlap"
  },
  "Pitfall: figures not closed in a loop": {
    "prefix": "plt_pitfall_memory",
    "body": [
      "# BAD: memory grows in a loop without closing figures",
      "# for x in data: plt.figure(); plt.plot(x); plt.savefig(...)",
      "",
      "# GOOD: always close",
      "for i, x in enumerate(${1:data}):",
      "    fig, ax = plt.subplots()",
      "    ax.plot(x)",
      "    fig.savefig(f'plot_{i}.png', bbox_inches='tight')",
      "    plt.close(fig)   # free memory"
