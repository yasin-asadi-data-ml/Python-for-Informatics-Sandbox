{
  "// ==================== 1. IMPORT & SETUP ====================": {
    "prefix": "plt_section_setup",
    "body": ["# ============ IMPORT & SETUP ============"],
    "description": "Section marker"
  },

  "Import Matplotlib": {
    "prefix": "plt_import",
    "body": [
      "import matplotlib.pyplot as plt",
      "import numpy as np",
      "",
      "# Optional: for Jupyter inline plots (not needed in scripts)",
      "# %matplotlib inline"
    ],
    "description": "Standard Matplotlib import"
  },
  "Set style": {
    "prefix": "plt_style",
    "body": [
      "# ---- Pick a style for consistent visuals ----",
      "plt.style.use('${1:seaborn-v0_8-whitegrid}')",
      "# Common styles:",
      "#   'default', 'ggplot', 'seaborn-v0_8', 'seaborn-v0_8-whitegrid',",
      "#   'seaborn-v0_8-darkgrid', 'fivethirtyeight', 'bmh', 'classic'",
      "",
      "# List all available styles:",
      "# print(plt.style.available)"
    ],
    "description": "Set a plotting style"
  },
  "Global rcParams": {
    "prefix": "plt_rcparams",
    "body": [
      "# ---- Global defaults for the whole session ----",
      "plt.rcParams.update({",
      "    'figure.figsize': (${1:8}, ${2:5}),",
      "    'figure.dpi': ${3:100},",
      "    'savefig.dpi': ${4:300},",
      "    'font.size': ${5:11},",
      "    'axes.titlesize': ${6:13},",
      "    'axes.labelsize': ${7:11},",
      "    'axes.grid': ${8:True},",
      "    'grid.alpha': 0.3,",
      "    'legend.frameon': False,",
      "})"
    ],
    "description": "Global style via rcParams"
  },
  "Backend (headless / script)": {
    "prefix": "plt_backend",
    "body": [
      "# ---- Use a non-interactive backend when running as a script ----",
      "import matplotlib",
      "matplotlib.use('Agg')   # no display; fast + safe for servers",
      "import matplotlib.pyplot as plt"
    ],
    "description": "Set non-interactive backend"
  },

  "// ==================== 2. FIGURE & AXES ANATOMY ====================": {
    "prefix": "plt_section_anatomy",
    "body": ["# ============ FIGURE & AXES ANATOMY ============"],
    "description": "Section marker"
  },

  "Object-oriented pattern (preferred)": {
    "prefix": "plt_fig_ax",
    "body": [
      "# ---- Object-oriented API (use this instead of pyplot state) ----",
      "fig, ax = plt.subplots(figsize=(${1:8}, ${2:5}))",
      "ax.plot(${3:x}, ${4:y})",
      "ax.set_title('${5:Title}')",
      "ax.set_xlabel('${6:x}')",
      "ax.set_ylabel('${7:y}')",
      "fig.tight_layout()",
      "plt.show()",
      "",
      "# Why OO? Explicit; works with multiple subplots; predictable."
    ],
    "description": "Figure + Axes (OO API)"
  },
  "Pyplot state-machine (quick)": {
    "prefix": "plt_pyplot_state",
    "body": [
      "# ---- Quick pyplot state-machine (fine for one-off plots) ----",
      "plt.figure(figsize=(${1:8}, ${2:5}))",
      "plt.plot(${3:x}, ${4:y})",
      "plt.title('${5:Title}')",
      "plt.xlabel('${6:x}')",
      "plt.ylabel('${7:y}')",
      "plt.show()"
    ],
    "description": "Pyplot state-machine style"
  },
  "Figure / Axes attributes": {
    "prefix": "plt_anatomy",
    "body": [
      "# ---- Anatomy of a plot ----",
      "# Figure = the whole canvas",
      "# Axes   = the plotting area (one per subplot)",
      "# Axis   = the x-axis or y-axis lines/ticks",
      "",
      "fig, ax = plt.subplots()",
      "ax.set_title('title')      # title of the axes",
      "ax.set_xlabel('x')          # x axis label",
      "ax.set_ylabel('y')          # y axis label",
      "ax.legend()                 # legend from labels",
      "fig.suptitle('figure title')  # title of the whole figure"
    ],
    "description": "Figure / Axes anatomy"
  },

  "// ==================== 3. SUBPLOTS & LAYOUT ====================": {
    "prefix": "plt_section_subplots",
    "body": ["# ============ SUBPLOTS & LAYOUT ============"],
    "description": "Section marker"
  },

  "Grid of subplots": {
    "prefix": "plt_subplots_grid",
    "body": [
      "# ---- Fixed grid ----",
      "fig, axes = plt.subplots(${1:2}, ${2:3}, figsize=(${3:15}, ${4:8}))",
      "axes[0, 0].plot(${5:x1}, ${6:y1})",
      "axes[0, 1].plot(${7:x2}, ${8:y2})",
      "axes[1, 2].plot(${9:x3}, ${10:y3})",
      "fig.tight_layout()",
      "plt.show()",
      "",
      "# axes is a NumPy array; flatten for iteration:",
      "# for ax in axes.flat: ax.grid(True)"
    ],
    "description": "Grid of subplots"
  },
  "Iterate over subplots": {
    "prefix": "plt_subplots_loop",
    "body": [
      "fig, axes = plt.subplots(1, len(${1:cols}), figsize=(15, 4), sharey=True)",
      "for ax, col in zip(axes, ${1:cols}):",
      "    ax.hist(df[col], bins=30)",
      "    ax.set_title(col)",
      "fig.tight_layout()"
    ],
    "description": "Loop over subplot axes"
  },
  "Subplot mosaic (gridspec)": {
    "prefix": "plt_gridspec",
    "body": [
      "# ---- Complex layouts with GridSpec (varying sizes) ----",
      "fig = plt.figure(figsize=(12, 8))",
      "gs = fig.add_gridspec(${1:2}, ${2:3}, hspace=0.3, wspace=0.3)",
      "ax1 = fig.add_subplot(gs[0, :])     # top row spans all columns",
      "ax2 = fig.add_subplot(gs[1, 0])",
      "ax3 = fig.add_subplot(gs[1, 1:])",
      "fig.tight_layout()"
    ],
    "description": "Flexible layout with gridspec"
  },
  "Subplot mosaic (concat)": {
    "prefix": "plt_subplot_mosaic",
    "body": [
      "# ---- subplot_mosaic (clean ASCII layout, 3.3+) ----",
      "fig, axd = plt.subplot_mosaic(",
      "    [['${1:left}', '${2:right}'],",
      "     ['${3:bottom}', '${3:bottom}']],",
      "    figsize=(10, 8),",
      ")",
      "axd['${1:left}'].plot(${4:x}, ${5:y})"
    ],
    "description": "subplot_mosaic for readable layouts"
  },
  "Shared axes": {
    "prefix": "plt_share_axes",
    "body": [
      "# ---- Share axes: synced zoom/pan ----",
      "fig, axes = plt.subplots(2, 1, sharex=True, sharey=False)"
    ],
    "description": "Shared axes"
  },
  "Twin axes (dual y-axes)": {
    "prefix": "plt_twinx",
    "body": [
      "# ---- Two y-axes sharing the same x ----",
      "fig, ax1 = plt.subplots(figsize=(8, 4))",
      "ax1.plot(${1:x}, ${2:y1}, color='C0', label='${3:y1}')",
      "ax1.set_ylabel('${4:Left}', color='C0')",
      "",
      "ax2 = ax1.twinx()",
      "ax2.plot(${1:x}, ${5:y2}, color='C1', label='${6:y2}')",
      "ax2.set_ylabel('${7:Right}', color='C1')",
      "",
      "fig.tight_layout()"
    ],
    "description": "Dual y-axes"
  },

  "// ==================== 4. BASIC PLOTS ====================": {
    "prefix": "plt_section_basic",
    "body": ["# ============ BASIC PLOTS ============"],
    "description": "Section marker"
  },

  "Line plot": {
    "prefix": "plt_line",
    "body": [
      "# ---- Line plot (trends over time/sequence) ----",
      "fig, ax = plt.subplots(figsize=(${1:8}, ${2:4}))",
      "ax.plot(${3:x}, ${4:y}, label='${5:series}')",
      "ax.set_title('${6:Title}')",
      "ax.set_xlabel('${7:x}')",
      "ax.set_ylabel('${8:y}')",
      "ax.legend()",
      "fig.tight_layout()"
    ],
    "description": "Line plot"
  },
  "Multiple lines": {
    "prefix": "plt_multi_line",
    "body": [
      "fig, ax = plt.subplots(figsize=(9, 5))",
      "for ${1:col} in ${2:columns}:",
      "    ax.plot(df['${3:x}'], df[${1:col}], label=${1:col})",
      "ax.set_xlabel('${3:x}')",
      "ax.set_ylabel('value')",
      "ax.legend()"
    ],
    "description": "Multiple lines on one plot"
  },
  "Scatter plot": {
    "prefix": "plt_scatter",
    "body": [
      "# ---- Scatter (relationship between two variables) ----",
      "fig, ax = plt.subplots(figsize=(7, 6))",
      "ax.scatter(df['${1:x}'], df['${2:y}'], s=${3:20}, alpha=${4:0.6})",
      "ax.set_xlabel('${1:x}')",
      "ax.set_ylabel('${2:y}')",
      "ax.set_title('${5:Scatter}')"
    ],
    "description": "Scatter plot"
  },
  "Scatter with color & size (bubble)": {
    "prefix": "plt_scatter_color",
    "body": [
      "# ---- Encode 4 dimensions: x, y, color, size ----",
      "fig, ax = plt.subplots(figsize=(8, 6))",
      "sc = ax.scatter(",
      "    df['${1:x}'], df['${2:y}'],",
      "    c=df['${3:color_col}'], cmap='${4:viridis}',",
      "    s=df['${5:size_col}'] * ${6:20},",
      "    alpha=0.7, edgecolors='w', linewidths=0.5,",
      ")",
      "plt.colorbar(sc, ax=ax, label='${3:color_col}')",
      "ax.set_xlabel('${1:x}'); ax.set_ylabel('${2:y}')"
    ],
    "description": "Bubble scatter (color + size)"
  },
  "Bar chart": {
    "prefix": "plt_bar",
    "body": [
      "# ---- Vertical bar chart (categorical comparison) ----",
      "fig, ax = plt.subplots(figsize=(${1:8}, ${2:4}))",
      "ax.bar(${3:categories}, ${4:values}, color='${5:steelblue}')",
      "ax.set_title('${6:Title}')",
      "ax.set_ylabel('${7:value}')",
      "plt.xticks(rotation=${8:45}, ha='right')",
      "fig.tight_layout()"
    ],
    "description": "Bar chart"
  },
  "Horizontal bar chart": {
    "prefix": "plt_barh",
    "body": [
      "# ---- Horizontal bars: better when category names are long ----",
      "fig, ax = plt.subplots(figsize=(8, ${1:5}))",
      "ax.barh(${2:categories}, ${3:values})",
      "ax.set_xlabel('${4:value}')",
      "ax.invert_yaxis()   # highest at top"
    ],
    "description": "Horizontal bar chart"
  },
  "Grouped bar chart": {
    "prefix": "plt_bar_grouped",
    "body": [
      "fig, ax = plt.subplots(figsize=(9, 5))",
      "x = np.arange(len(${1:categories}))",
      "width = ${2:0.35}",
      "ax.bar(x - width/2, ${3:values_a}, width, label='${4:A}')",
      "ax.bar(x + width/2, ${5:values_b}, width, label='${6:B}')",
      "ax.set_xticks(x); ax.set_xticklabels(${1:categories})",
      "ax.legend()"
    ],
    "description": "Grouped bars"
  },
  "Stacked bar chart": {
    "prefix": "plt_bar_stacked",
    "body": [
      "fig, ax = plt.subplots(figsize=(9, 5))",
      "ax.bar(${1:categories}, ${2:values_a}, label='${3:A}')",
      "ax.bar(${1:categories}, ${4:values_b}, bottom=${2:values_a}, label='${5:B}')",
      "ax.legend()"
    ],
    "description": "Stacked bars"
  },
  "Histogram": {
    "prefix": "plt_hist",
    "body": [
      "# ---- Histogram (distribution of a single feature) ----",
      "fig, ax = plt.subplots(figsize=(8, 4))",
      "ax.hist(df['${1:col}'], bins=${2:30}, edgecolor='white')",
      "ax.set_xlabel('${1:col}')",
      "ax.set_ylabel('frequency')",
      "ax.set_title('Distribution of ${1:col}')"
    ],
    "description": "Histogram"
  },
  "Histogram with KDE": {
    "prefix": "plt_hist_kde",
    "body": [
      "# ---- Histogram + smooth density (requires SciPy for kde) ----",
      "import seaborn as sns",
      "fig, ax = plt.subplots(figsize=(8, 4))",
      "sns.histplot(df['${1:col}'], bins=${2:30}, kde=True, ax=ax)"
    ],
    "description": "Histogram with KDE"
  },
  "Pie chart": {
    "prefix": "plt_pie",
    "body": [
      "# ---- Pie: use sparingly; only when parts make a whole ----",
      "fig, ax = plt.subplots(figsize=(6, 6))",
      "ax.pie(${1:values}, labels=${2:labels}, autopct='%1.1f%%', startangle=90)",
      "ax.axis('equal')   # makes it circular"
    ],
    "description": "Pie chart"
  },
  "Box plot": {
    "prefix": "plt_boxplot",
    "body": [
      "# ---- Box plot (distribution + outliers) ----",
      "fig, ax = plt.subplots(figsize=(8, 5))",
      "ax.boxplot([${1:group_a}, ${2:group_b}], labels=['${3:A}', '${4:B}'])",
      "ax.set_ylabel('${5:value}')",
      "ax.set_title('${6:Distribution by group}')"
    ],
    "description": "Box plot"
  },
  "Violin plot": {
    "prefix": "plt_violin",
    "body": [
      "# ---- Violin: like a box plot but shows full distribution shape ----",
      "fig, ax = plt.subplots(figsize=(8, 5))",
      "ax.violinplot([${1:group_a}, ${2:group_b}], showmeans=True)",
      "ax.set_xticks([1, 2])",
      "ax.set_xticklabels(['${3:A}', '${4:B}'])"
    ],
    "description": "Violin plot"
  },
  "Error bars": {
    "prefix": "plt_errorbar",
    "body": [
      "# ---- Error bars (mean ± std) ----",
      "fig, ax = plt.subplots()",
      "ax.errorbar(${1:x}, ${2:y}, yerr=${3:yerr}, fmt='o-', capsize=4)"
    ],
    "description": "Error bars"
  },
  "Fill between (uncertainty band)": {
    "prefix": "plt_fill_between",
    "body": [
      "# ---- Confidence / uncertainty band ----",
      "fig, ax = plt.subplots()",
      "ax.plot(${1:x}, ${2:mean}, label='mean')",
      "ax.fill_between(${1:x}, ${3:lower}, ${4:upper}, alpha=0.3, label='${5:95% CI}')",
      "ax.legend()"
    ],
    "description": "Fill between (CI band)"
  },
  "Stem plot": {
    "prefix": "plt_stem",
    "body": [
      "fig, ax = plt.subplots()",
      "ax.stem(${1:x}, ${2:y})"
    ],
    "description": "Stem plot"
  },
  "Stairs / step plot": {
    "prefix": "plt_step",
    "body": [
      "# ---- Step plot (ECDFs, cumulative counts) ----",
      "fig, ax = plt.subplots()",
      "ax.step(${1:x}, ${2:y}, where='${3:mid}')"
    ],
    "description": "Step plot"
  },

  "// ==================== 5. STYLING ====================": {
    "prefix": "plt_section_styling",
    "body": ["# ============ STYLING ============"],
    "description": "Section marker"
  },

  "Colors": {
    "prefix": "plt_colors",
    "body": [
      "# ---- Colors ----",
      "color='${1:steelblue}'              # named color",
      "color='#${2:1f77b4}'                 # hex",
      "color=(${3:0.1}, ${4:0.5}, ${5:0.9})  # RGB tuple",
      "color='C0'                       # color cycle index (C0..C9)"
    ],
    "description": "Color specifications"
  },
  "Markers": {
    "prefix": "plt_markers",
    "body": [
      "# ---- Markers ----",
      "# o circle | s square | ^ triangle up | v triangle down | * star",
      "# + plus | x cross | D diamond | p pentagon | . point",
      "ax.plot(x, y, marker='${1:o}', markersize=${2:6})"
    ],
    "description": "Marker styles"
  },
  "Line styles": {
    "prefix": "plt_linestyle",
    "body": [
      "# ---- Line styles ----",
      "# '-' solid | '--' dashed | '-.' dash-dot | ':' dotted | 'None'",
      "ax.plot(x, y, linestyle='${1:--}', linewidth=${2:1.8})"
    ],
    "description": "Line styles"
  },
  "Color maps": {
    "prefix": "plt_colormaps",
    "body": [
      "# ---- Colormaps ----",
      "# Sequential: 'viridis', 'plasma', 'cividis', 'Blues', 'Greens'",
      "# Diverging:  'coolwarm', 'RdBu_r', 'bwr', 'seismic'",
      "# Cyclic:     'twilight', 'hsv'",
      "# Qualitative:'tab10', 'Set1', 'Paired'",
      "",
      "cmap = plt.get_cmap('${1:viridis}')"
    ],
    "description": "Colormaps"
  },

  "// ==================== 6. AXES CUSTOMIZATION ====================": {
    "prefix": "plt_section_axes",
    "body": ["# ============ AXES CUSTOMIZATION ============"],
    "description": "Section marker"
  },

  "Axis limits": {
    "prefix": "plt_axis_limits",
    "body": [
      "ax.set_xlim(${1:0}, ${2:10})",
      "ax.set_ylim(${3:0}, ${4:100})",
      "ax.set_xlim(left=0)               # only the lower bound",
      "ax.margins(x=0.05, y=0.05)         # padding around data"
    ],
    "description": "Set axis limits"
  },
  "Axis scales": {
    "prefix": "plt_axis_scale",
    "body": [
      "# ---- Linear / log / symlog / logit ----",
      "ax.set_xscale('${1:linear}')",
      "ax.set_yscale('${2:log}')     # useful for skewed distributions",
      "ax.set_yscale('${3:logit}')   # useful for probabilities",
      "",
      "# Log-log plot:",
      "ax.loglog(x, y)"
    ],
    "description": "Axis scales (log, symlog, logit)"
  },
  "Ticks & tick labels": {
    "prefix": "plt_ticks",
    "body": [
      "ax.set_xticks([${1:0, 1, 2, 3}])",
      "ax.set_xticklabels(['${2:a}', '${3:b}', '${4:c}', '${5:d}'])",
      "ax.tick_params(axis='${6:x}', rotation=${7:45})",
      "ax.minorticks_on()",
      "",
      "# Custom tick formatter:",
      "from matplotlib.ticker import FuncFormatter",
      "ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f'{v:.0%}'))"
    ],
    "description": "Ticks and tick labels"
  },
  "Grid": {
    "prefix": "plt_grid",
    "body": [
      "ax.grid(True, which='${1:major}', alpha=${2:0.3}, linestyle='${3:--}')",
      "ax.grid(True, axis='${4:y}')",
      "ax.grid(False)"
    ],
    "description": "Grid lines"
  },
  "Axis spine visibility": {
    "prefix": "plt_spines",
    "body": [
      "# ---- Remove spines for a minimal look ----",
      "for side in ['top', 'right']:",
      "    ax.spines[side].set_visible(False)"
    ],
    "description": "Spine visibility"
  },
  "Legend": {
    "prefix": "plt_legend",
    "body": [
      "ax.legend(",
      "    loc='${1:best}',          # upper right, lower left, best, ...",
      "    title='${2:Legend title}',",
      "    ncol=${3:2},",
      "    frameon=${4:False},",
      "    fontsize=${5:10},",
      ")"
    ],
    "description": "Legend customization"
  },
  "Text & title": {
    "prefix": "plt_text_title",
    "body": [
      "ax.set_title('${1:Title}', fontsize=${2:14}, fontweight='${3:bold}')",
      "ax.set_xlabel('${4:x}', fontsize=${5:11})",
      "ax.set_ylabel('${6:y}', fontsize=${5:11})",
      "fig.suptitle('${7:Figure title}', fontsize=16)"
    ],
    "description": "Titles and labels"
  },
  "Annotate a point": {
    "prefix": "plt_annotate",
    "body": [
      "ax.annotate('${1:label}',",
      "    xy=(${2:x_pt}, ${3:y_pt}),",
      "    xytext=(${4:x_txt}, ${5:y_txt}),",
      "    arrowprops=dict(arrowstyle='->', color='${6:gray}'),",
      "    fontsize=${7:10},",
      ")"
    ],
    "description": "Annotate a point with an arrow"
  },
  "Reference lines": {
    "prefix": "plt_reflines",
    "body": [
      "ax.axhline(y=${1:0}, color='${2:gray}', linestyle='--', linewidth=1)",
      "ax.axvline(x=${3:0}, color='${4:gray}', linestyle='--', linewidth=1)",
      "ax.axhspan(${5:ymin}, ${6:ymax}, alpha=0.1, color='${7:yellow}')",
      "ax.axvspan(${8:xmin}, ${9:xmax}, alpha=0.1, color='${10:red}')"
    ],
    "description": "Horizontal/vertical reference lines and bands"
  },

  "// ==================== 7. 2D DATA VISUALIZATION ====================": {
    "prefix": "plt_section_2d",
    "body": ["# ============ 2D DATA VISUALIZATION ============"],
    "description": "Section marker"
  },

  "imshow (image / matrix)": {
    "prefix": "plt_imshow",
    "body": [
      "# ---- Display a 2D array as an image ----",
      "fig, ax = plt.subplots(figsize=(6, 6))",
      "im = ax.imshow(${1:matrix}, cmap='${2:viridis}', aspect='auto')",
      "plt.colorbar(im, ax=ax, label='${3:value}')"
    ],
    "description": "imshow for images or matrices"
  },
  "Heatmap (matrix + labels)": {
    "prefix": "plt_heatmap",
    "body": [
      "# ---- Heatmap with values annotated ----",
      "fig, ax = plt.subplots(figsize=(8, 6))",
      "im = ax.imshow(${1:matrix}, cmap='${2:coolwarm}', aspect='auto')",
      "ax.set_xticks(range(len(${3:x_labels}))); ax.set_xticklabels(${3:x_labels}, rotation=45, ha='right')",
      "ax.set_yticks(range(len(${4:y_labels}))); ax.set_yticklabels(${4:y_labels})",
      "plt.colorbar(im, ax=ax)",
      "",
      "# Annotate values:",
      "for i in range(${1:matrix}.shape[0]):",
      "    for j in range(${1:matrix}.shape[1]):",
      "        ax.text(j, i, f'{${1:matrix}[i, j]:.2f}', ha='center', va='center', color='w')"
    ],
    "description": "Annotated heatmap"
  },
  "Contour plot": {
    "prefix": "plt_contour",
    "body": [
      "# ---- Contour lines of a 2D field ----",
      "fig, ax = plt.subplots(figsize=(7, 6))",
      "cs = ax.contour(${1:X}, ${2:Y}, ${3:Z}, levels=${4:10}, cmap='${5:viridis}')",
      "ax.clabel(cs, inline=True, fontsize=8)",
      "plt.colorbar(cs, ax=ax)"
    ],
    "description": "Contour plot"
  },
  "Contourf (filled)": {
    "prefix": "plt_contourf",
    "body": [
